<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ExpenseTracker.Views"
       x:Class="ExpenseTracker.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Витрати"
                      Icon="{FontImageSource Glyph='₴', Color=Gray, Size=22}"
                      ContentTemplate="{DataTemplate views:ExpensesPage}"
                      Route="expenses" />
        <ShellContent Title="Статистика"
                      Icon="{FontImageSource Glyph='📊', Color=Gray, Size=22}"
                      ContentTemplate="{DataTemplate views:StatsPage}"
                      Route="stats" />
        <ShellContent Title="Валюти"
                      Icon="{FontImageSource Glyph='💱', Color=Gray, Size=22}"
                      ContentTemplate="{DataTemplate views:CurrencyPage}"
                      Route="currency" />
    </TabBar>
</Shell>
